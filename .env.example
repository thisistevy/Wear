# Copy this file to .env and fill in the values. .env is git-ignored.

# Public Mapbox access token, used by the map on the home page.
# Get one at https://account.mapbox.com/access-tokens/ (it starts with "pk.").
MAPBOX_API_KEY=

# Required on Node 17 and above: Webpack 4 hashes with MD4 through OpenSSL,
# which OpenSSL 3 removed. Without it webpack fails with
# ERR_OSSL_EVP_UNSUPPORTED and Rails keeps serving a stale JS bundle.
NODE_OPTIONS=--openssl-legacy-provider
