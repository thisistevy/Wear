<h2><%= point.name %></h2>
<p><%= point.point_type.capitalize %></p>
<p><%= point.address %></p>
<% if point.description.present? %>
  <p><%= point.description %></p>
<% end %>
<% if point.website.present? %>
  <p><%= link_to "Visit website", point.website, target: "_blank", rel: "noopener" %></p>
<% end %>
