<%= render "/shared/header" %>

<div class="main-container map-page">
  <div class="banner" style="background-image: linear-gradient(rgba(27,67,50,0.55),rgba(45,106,79,0.35)), url('<%= cl_image_path "homepage_background_lbfwxz", height: 1500, crop: :fill %>')">
    <h1>Wear the people</h1>
    <h2>Find your next cool outfits and help cooling down the planet</h2>

    <form id="map-search" class="map-search" role="search">
      <input type="search" name="place" placeholder="Search a city or an address" aria-label="Search a city or an address">
      <button type="submit" class="btn-light-green">Search</button>
    </form>
    <p id="map-search-feedback" class="map-search-feedback" role="status" aria-live="polite"></p>

    <div class="map-legend" id="map-filters">
      <button type="button" class="map-filter is-active" data-category="store" data-label="stores" aria-pressed="false">
        <i class="fas fa-circle" style="color:#AAD576"></i> Visit eco-friendly stores
      </button>
      <button type="button" class="map-filter is-active" data-category="collection" data-label="drop-off points" aria-pressed="false">
        <i class="fas fa-circle" style="color:#4A90D9"></i> Give your outfits
      </button>
      <button type="button" class="map-filter is-active" data-category="recycling" data-label="recycling points" aria-pressed="false">
        <i class="fas fa-circle" style="color:#F4A259"></i> Recycle your outfit
      </button>
      <button type="button" class="map-filter is-active" data-category="sell" data-label="resale shops" aria-pressed="false">
        <i class="fas fa-circle" style="color:#E08E6D"></i> Sell your outfits
      </button>
    </div>
    <p id="map-count" class="map-count" role="status" aria-live="polite"></p>
  </div>

  <div class="map-section">
    <% if ENV['MAPBOX_API_KEY'].blank? %>
      <p class="alert alert-warning">
        The map cannot be displayed: <code>MAPBOX_API_KEY</code> is not set.
        Add your Mapbox token to the <code>.env</code> file at the root of the
        project, then restart the server.
      </p>
    <% end %>

    <div id="map"
       data-markers="<%= @markers.to_json %>"
       data-mapbox-api-key="<%= ENV['MAPBOX_API_KEY'] %>">
    </div>
  </div>
</div>
