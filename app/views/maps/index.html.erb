<%= render "/shared/header" %>

<div class="main-container map-page">
  <div class="banner">
    <h1>Wear the people</h1>
    <h2>Buy, sell, give or recycle your clothes — and help cool the planet</h2>

    <form id="map-search" class="map-search" role="search">
      <%# The placeholder shows examples; the aria-label spells out the intent,
          since a list of city names read aloud doesn't explain the field. %>
      <input type="search" name="place"
             placeholder="Paris, Bordeaux, 12 rue de Rivoli…"
             aria-label="Search a city or address to move the map">
      <button type="submit" class="btn-light-green">Search</button>
    </form>
    <p id="map-search-feedback" class="map-search-feedback" role="status" aria-live="polite"></p>

    <div class="map-legend" id="map-filters" role="group" aria-label="Filter places by what you want to do">
      <button type="button" class="map-filter" data-category="store" aria-pressed="false">
        <i class="fas fa-store" style="color:#AAD576"></i> Buy eco-friendly
      </button>
      <button type="button" class="map-filter" data-category="sell" aria-pressed="false">
        <i class="fas fa-tag" style="color:#E08E6D"></i> Sell your outfits
      </button>
      <button type="button" class="map-filter" data-category="collection" aria-pressed="false">
        <i class="fas fa-hand-holding-heart" style="color:#4A90D9"></i> Give your outfits
      </button>
      <button type="button" class="map-filter" data-category="recycling" aria-pressed="false">
        <i class="fas fa-recycle" style="color:#F4A259"></i> Recycle your outfit
      </button>
    </div>
  </div>

  <div class="map-section">
    <% if ENV['MAPBOX_API_KEY'].blank? %>
      <p class="alert alert-warning">
        The map cannot be displayed: <code>MAPBOX_API_KEY</code> is not set.
        Add your Mapbox token to the <code>.env</code> file at the root of the
        project, then restart the server.
      </p>
    <% end %>

    <div class="map-layout">
      <div id="map"
         data-markers="<%= @markers.to_json %>"
         data-mapbox-api-key="<%= ENV['MAPBOX_API_KEY'] %>">
      </div>

      <%# Filled in by init_mapbox.js from the markers already on the map, so
          the list and the map can never disagree about what is shown. %>
      <aside id="map-list" class="map-list" aria-label="Places shown on the map">
        <%# Echoes the last search. Empty — and collapsed — until one is made. %>
        <p id="map-list-query" class="map-list-query"></p>
        <p class="map-list-count" role="status" aria-live="polite"></p>
        <ul class="map-list-items"></ul>
      </aside>
    </div>
  </div>
</div>
