<%= render "/shared/header" %>

<div class="main-container">
  <h1>Map</h1>
  <div class="map-legend">
    <span><i class="fas fa-circle" style="color:#AAD576"></i> Eco-friendly stores</span>
    <span><i class="fas fa-circle" style="color:#4A90D9"></i> Collection points</span>
    <span><i class="fas fa-circle" style="color:#F4A259"></i> Recycling points</span>
  </div>

  <% if ENV['MAPBOX_API_KEY'].blank? %>
    <p class="alert alert-warning">
      The Mapbox key is not configured (<code>MAPBOX_API_KEY</code> variable). The map cannot be displayed for now.
    </p>
  <% end %>

  <div id="map"
     style="width: 100%; height: 600px; margin: auto; margin-top: 5px; border-radius: 5px;"
     data-markers="<%= @markers.to_json %>"
     data-mapbox-api-key="<%= ENV['MAPBOX_API_KEY'] %>">
  </div>
</div>
