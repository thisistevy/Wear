<%= render "/shared/header" %>

<div class="main-container">
  <h1>Répertoire des marques éco-friendly</h1>

  <% if @certifications.any? %>
    <div class="searchbar-home">
      <%= simple_form_for :brands_filter, url: brands_path, method: :get do |f| %>
        <%= f.input :certification, label: false, prompt: "Certification", collection: @certifications, required: false %>
        <%= submit_tag "Filtrer", class: "btn-light-green" %>
      <% end %>
    </div>
  <% end %>

  <ul class="container-product">
    <% @brands.each do |brand| %>
      <%= render "card", brand: brand %>
    <% end %>
  </ul>
</div>
