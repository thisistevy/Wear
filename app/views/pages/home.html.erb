<%= render "/shared/header" %>

<div class="main-container">
  <div class="banner" style="background-image: linear-gradient(rgba(27,67,50,0.55),rgba(45,106,79,0.35)), url('<%= cl_image_path "homepage_background_lbfwxz", height: 1500, crop: :fill %>')">
    <h1>Wear the people</h1>
    <h2>Find your next cool outfits and help cooling down the planet</h2>
    <% unless user_signed_in?%>
      <%= link_to "Voir les produits","products", id: "button-call-to-action" %>
    <% end %>
    <% if user_signed_in?%>
      <div class="searchbar-home" id="seachbar-home">
        <%= simple_form_for :products_filter, url: products_path, method: :get do |f| %>
          <%= f.input :query, label: false, required: false, placeholder: "Rechercher un produit", style: "width: 350px" %>
          <div class="button-space">
            <%= submit_tag "Rechercher", class: "btn-light-green"%>
          </div>
        <% end %>
      </div>
    <% end %>
    <a href="#articles-list">
      <i class="fas fa-chevron-down"></i>
    </a>
  </div>

  <div class="articles" id="articles-list">
    <h2>Le guichet unique de la mode durable</h2>
    <div class="pillars-grid">
      <%= link_to listings_path, class: "pillar-card" do %>
        <i class="fas fa-store"></i>
        <h3>Marketplace</h3>
        <p>Achetez, revendez ou échangez des vêtements de seconde main près de chez vous.</p>
      <% end %>
      <%= link_to new_scan_path, class: "pillar-card" do %>
        <i class="fas fa-barcode"></i>
        <h3>Scan transparence</h3>
        <p>Scannez un code-barres pour connaître la composition et le score éco-responsable d'un vêtement.</p>
      <% end %>
      <%= link_to products_path, class: "pillar-card" do %>
        <i class="fas fa-star"></i>
        <h3>Score de durabilité</h3>
        <p>Découvrez la longévité réelle des vêtements, évaluée par la communauté.</p>
      <% end %>
      <%= link_to brands_path, class: "pillar-card" do %>
        <i class="fas fa-award"></i>
        <h3>Marques éco-friendly</h3>
        <p>Explorez un répertoire de marques engagées et certifiées.</p>
      <% end %>
      <%= link_to map_path, class: "pillar-card" do %>
        <i class="fas fa-map-marked-alt"></i>
        <h3>Carte</h3>
        <p>Localisez les boutiques éco-friendly et les points de collecte/recyclage à proximité.</p>
      <% end %>
    </div>
    <h2><%= link_to "À propos", aboutus_path, id:"aboutus-header" %></h2>
  </div>
</div>
